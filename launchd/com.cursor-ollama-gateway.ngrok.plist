<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cursor-ollama-gateway.ngrok</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>source /usr/local/etc/cursor-ollama-gateway/.env &amp;&amp; exec "$(command -v ngrok)" start --config /usr/local/etc/cursor-ollama-gateway/ngrok.yml cursor-ollama</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/usr/local/etc/cursor-ollama-gateway</string>

  <key>StandardOutPath</key>
  <string>/usr/local/var/log/cursor-ollama-gateway/ngrok.out.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/cursor-ollama-gateway/ngrok.err.log</string>
</dict>
</plist>
